import Toybox.Graphics;
import Toybox.Lang;

class Theme {

    function initialize() {
    }

    function getCanvasColor() as Number {
        return 0xF1E8D2;
    }

    function getPanelColor() as Number {
        return 0x252525;
    }

    function getPanelHighlightColor() as Number {
        return 0x3A3A3A;
    }

    function getPrimaryTextColor() as Number {
        return 0xF4EFE5;
    }

    function getSecondaryTextColor() as Number {
        return 0x2A2926;
    }

    function getAccentColor() as Number {
        return 0xB33A2E;
    }

    function getGaugeColor() as Number {
        return 0x5D7F54;
    }

    function getShadowColor() as Number {
        return 0x111111;
    }

}